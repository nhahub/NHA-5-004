# --- App ---
APP_ENV=development
SECRET_KEY=change-me

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_search_agent

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider ---
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-6

# --- Job Search API (Phase 3, structured search) ---
JOB_API_BASE_URL=https://api.adzuna.com/v1/api/jobs
JOB_API_APP_ID=your-adzuna-app-id
JOB_API_KEY=your-adzuna-app-key
# --- RAG / Vector store ---
VECTOR_DB_PATH=./data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- File storage ---
RESUME_STORAGE_PATH=./data/resumes
