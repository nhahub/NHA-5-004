# --- App ---
APP_ENV=development
SECRET_KEY=change-me

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_search_agent

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider ---
Groq_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b

# --- Web Search ---
TAVILY_API_KEY = your-tavily-api-key

# --- Job Search API (Phase 3, structured search) ---
JOB_API_BASE_URL=https://api.example-job-board.com
JOB_API_KEY=your-job-api-key

# --- RAG / Vector store ---
VECTOR_DB_PATH=./data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- File storage ---
RESUME_STORAGE_PATH=./data/resumes
